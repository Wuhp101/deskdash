// deskdash settings. Copy to config.json (gitignored) and edit; the running dashboard picks up changes
// within 2 seconds. JSON5: comments and trailing commas are fine. Every key is optional, and anything
// left out uses the default shown here.
{
  "language": "",                   // menus and alerts: "" follows macOS, or "en", "zh-Hant"
  "display": {
    "match": "Wokyis",              // part of the screen's name in System Settings > Displays; only it is covered
    "keepOffMain": false,           // when a monitor is connected and the dock screen is main, make the monitor main
    "virtualMain": false,           // when the dock screen is the only display (used remotely, e.g. Parsec), add a
                                    // virtual main display until a monitor is connected (a private macOS API)
    "virtualWidth": 1920,           // its size in points
    "virtualHeight": 1080,
    "virtualHiDPI": false,          // render it at twice that, like a Retina display
    "powerOff": true,               // when it goes black (schedule.idleMinutes, schedule.sleep), turn the panel off over
                                    // DDC too, backlight and all, if it takes the command (a private macOS API)
    "backlight": true,              // dim at night with the panel's backlight over DDC, keeping contrast, if it takes it
  },
  "pages": {
    "order": ["clock", "music", "photos", "climate", "markets", "agents", "limits", "tokens", "system"],  // all but clock and markets only rotate in when they have data
    "seconds": 12,                  // how long each page stays up
    "durations": { "clock": 15 },   // per-page overrides
  },
  "clock": {
    "use24h": true,
    "timeZone": "",                 // an IANA zone like "Europe/London"; "" follows this Mac
  },
  "weather": {                      // set from Settings → Weather & Time, which searches by city
    "enabled": true,
    "place": "",                    // e.g. "Lisbon, Portugal"; until a place is set there is no weather
    "latitude": null,               // e.g. 38.717
    "longitude": null,              // e.g. -9.133
    "timeZone": "",                 // the place's own zone, e.g. "Europe/Lisbon", so the clock can follow it
    "fahrenheit": false,
  },
  "markets": {
    "symbols": ["BTC", "ETH", "SOL"],  // Hyperliquid perp names (BTC, ETH, SOL, HYPE, kPEPE, ...)
    "perPage": 3,                   // 1 to 5, sized to fill the page; more symbols make more pages
  },
  "agents": {
    "claude": true,                 // read Claude Code's own session registry, ~/.claude/sessions
    "stateDir": "~/.local/state/deskdash/agents",  // where hooks/agent-status.sh writes (Codex)
    "doneMinutes": 15,              // a session that finished its turn shows DONE (green) this long, then IDLE
    "maxIdleHours": 12,             // idle sessions older than this are hidden
    "jumpOnWaiting": true,          // jump to the agents page when a session needs you
    "jumpOnDone": true,             // ...and briefly when one finishes
    "holdSeconds": 20,              // how long a jump holds the agents page
  },
  "limits": {                       // the limits page: what is left of the plans' 5-hour and weekly windows
    "claude": "~/.local/state/deskdash/limits/claude.json",  // written by hooks/claude-statusline.sh; "" leaves Claude out
    "codex": "~/.codex",            // Codex's home; its session logs carry the limits after each reply; "" leaves Codex out
    "alertBelow": 20,               // alert when a window has less than this percent left, once until it resets
    "jumpOnAlert": true,            // ...and jump to the limits page
  },
  "tokens": {                       // the tokens page: what the coding agents used, by day and all time
    "weeks": 26,                    // weeks of days in the heatmap, 4 to 53
    "claude": "~/.claude/projects", // Claude Code's transcripts; "" leaves Claude out. Only the token counts are read
    "codex": "~/.codex",            // Codex's home (sessions/ and archived_sessions/); "" leaves Codex out
    "gemini": "~/.gemini",          // Gemini CLI's home (tmp/<project>/chats/); "" leaves Gemini out
    "muse": "~/.local/share/muse",  // Muse Code's data folder (sessions/); "" leaves Muse out
    "history": "~/.local/state/deskdash/tokens.json",  // each day's totals, kept past Claude Code's 30 days; "" keeps none
  },
  "dyson": {
    "enabled": true,
    "credentials": "secrets/dyson.json",  // written by Settings → Purifier or `deskdash dyson setup` (gitignored)
    "host": "",                     // the purifier's IP or host[:port]; "" finds it by name on the network
  },
  "telegram": {
    "channels": [],                 // public channels (t.me/<name>), e.g. ["telegram"]; new posts show full screen
    "seconds": 5,                   // how long each post stays up
    "pollSeconds": 20,              // how often to check for new posts (about 5 KB per check)
  },
  "stats": {
    "enabled": true,                // CPU, temperature, memory, SSD and network meters along the bottom of the clock page
  },
  "music": {                        // what Music or Spotify plays on this Mac; the Now Playing page is "music" in pages.order
    "onClock": true,                // a line on the clock page while something plays
    "artwork": true,                // look up covers: Spotify's oEmbed, Apple's iTunes Search (public, no key)
    "takeover": false,              // each new track takes the screen for takeoverSeconds, like a Telegram post
    "takeoverSeconds": 5,
  },
  "photos": {                       // the photos page: pictures from a folder of yours
    "folder": "",                   // e.g. "~/Pictures/deskdash", its subfolders included; "" has no photos page
    "album": "",                    // or an album in the Photos app, by name (e.g. "Favorites"); `deskdash ctl albums` logs them
    "shuffle": true,
    "fill": false,                  // crop to fill the screen; false shows each whole over a blurred copy of itself
    "clock": true,                  // the time and date in the corner
  },
  "schedule": {
    "keepAwakeOutsideSleep": false, // hold the displays awake whenever it is not sleep hours, instead of keepAwake's window
    "keepAwake": "08:00-23:00",     // hold the displays awake in this window ("" = never; macOS can't keep only one awake)
    "dim": "23:00-08:00",           // the night: draw at dimBrightness in this window ("" = never)
    "dimBrightness": 0.35,          // at night
    "dayBrightness": 1,             // the rest of the day (0.05 to 1, drawn over the page, not the backlight)
    "idleMinutes": 0,               // black after this many minutes without keyboard or mouse input; input or an alert
                                    // brings it back (0 = never)
    "sleep": "",                    // sleep hours, e.g. "23:00-08:00": black whatever happens, and the displays may sleep
    "quiet": "",                    // quiet hours, e.g. "23:00-08:00": alerts make no sound
    "weekend": {                    // Saturday's and Sunday's own sleep and quiet hours
      "enabled": false,
      "sleep": "",
      "quiet": "",
    },
  },
  "alerts": {                       // when a session needs you, one finishes, or a limit runs low
    "sound": false,                 // play a sound, again until someone uses the keyboard or mouse
    "card": false,                  // a card at the top right of the main screen, until it is over or closed
    "notify": true,                 // ring through Notification Center, which keeps quiet in a Focus; false plays it directly
    "waiting": "Glass",             // macOS alert sounds by name (/System/Library/Sounds); "" stays quiet
    "done": "Hero",
    "limit": "Funk",
    "volume": 1,                    // only when notify is false
    "repeatSeconds": 30,            // the first repeat; each wait is half as long again, up to repeatMaxSeconds
    "repeatMaxSeconds": 180,
  },
}
